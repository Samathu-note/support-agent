# Copy to .env and fill in for real use. The pipeline runs without an
# LLM key too (falls back to templates), but replies/judging are much
# weaker without it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Set USE_SQLITE=false to use MySQL instead of the local sqlite file.
USE_SQLITE=true
MYSQL_DATABASE=hiver_agent
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
